# Copy to .env (git-ignored) and fill in real values. Never commit .env itself.
# In Vercel: Project > Settings > Environment Variables > add TP_SECRET_KEY.

# Required. ToroPay API key (server-side only).
TP_SECRET_KEY=

# Optional. 'test' or 'live'.
TP_MODE=test

# Optional. Defaults to the ToroPay sandbox.
TP_API_BASE=https://staging.toropay.co.in

# Optional. 0 = charge the full order total (default). Set e.g. 500 to charge a deposit instead.
TP_DEPOSIT_AMOUNT=0
